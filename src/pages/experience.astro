---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import { experience, education, leadership } from '../data/experience';
import { skills } from '../data/skills';

const hasCv = existsSync('public/cv.pdf');
---

<Base title="Experience" description="Work and research experience, education, and skills of Anthony Reyna.">
  <div class="container narrow">
    <header class="page-head">
      <h1>Experience</h1>
      <p>
        One software engineering internship and four years of research.
        {hasCv && <> The full CV is also available <a href="/cv.pdf">as a PDF</a>.</>}
      </p>
    </header>

    <section>
      <h2 class="label">Work and research</h2>
      {
        experience.map((r) => (
          <div class="entry">
            <div class="when">{r.period}</div>
            <div>
              <h3>{r.title}</h3>
              <p class="where">
                {r.org} · {r.place}
              </p>
              <ul>
                {r.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
              {r.related && (
                <p class="related">
                  {r.related.map((l) => (
                    <a href={l.href}>{l.label} →</a>
                  ))}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </section>

    <section class="section">
      <h2 class="label">Education</h2>
      {
        education.map((e) => (
          <div class="entry">
            <div class="when">{e.period}</div>
            <div>
              <h3>{e.school}</h3>
              <p class="where">{e.degree}</p>
              <p class="muted small">{e.notes}</p>
            </div>
          </div>
        ))
      }
    </section>

    <section class="section">
      <h2 class="label">Leadership</h2>
      {
        leadership.map((r) => (
          <div class="entry">
            <div class="when">{r.period}</div>
            <div>
              <h3>{r.title}</h3>
              <p class="where">
                {r.org} · {r.place}
              </p>
              <ul>
                {r.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </section>

    <section class="section">
      <h2 class="label">Tools I've worked with</h2>
      <p class="muted small intro">Grouped by where I used them, so each one links back to real work.</p>
      {
        skills.map((g) => (
          <div class="entry">
            <div class="when">{g.heading}</div>
            <div>
              <ul class="tags">
                {g.items.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              <p class="muted small context">{g.context}</p>
            </div>
          </div>
        ))
      }
    </section>

    <section class="section">
      <h2 class="label">Thanks</h2>
      <p class="muted small">
        I've been lucky to learn from Prof. <a href="https://eric-xw.github.io/">Xin Eric Wang</a> (ERIC Lab) and Prof.{' '}
        <a href="https://yuyinzhou.github.io/">Yuyin Zhou</a> (VLAA Lab) at UC Santa Cruz, and from Prof. Dan Klein,
        Prof. Trevor Darrell, and my mentor <a href="https://rcorona.github.io/">Rodolfo Corona</a> at UC Berkeley.
      </p>
    </section>
  </div>
</Base>

<style>
  .label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 1.25rem;
  }

  .small {
    font-size: 0.95rem;
    margin: 0;
  }

  .intro {
    margin: -0.5rem 0 1.25rem;
  }

  .related {
    margin: 0.6rem 0 0;
    display: flex;
    gap: 1rem;
    font-size: 0.95rem;
  }

  .context {
    margin-top: 0.5rem;
  }
</style>
