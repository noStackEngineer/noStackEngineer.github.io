---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<Base title="Blog" description="Notes on what I'm learning.">
  <div class="container narrow">
    <header class="page-head">
      <h1>Blog</h1>
      <p>Notes on what I'm learning.</p>
    </header>
    {posts.length === 0 && <p class="muted">No posts yet.</p>}
    <ul class="posts">
      {
        posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
            </time>
            <div>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              {post.data.draft && <span class="draft">Draft</span>}
              <p>{post.data.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .posts li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }

  time {
    color: var(--faint);
    font-size: 0.95rem;
  }

  .posts a {
    font-weight: 600;
    color: var(--text);
  }

  .posts p {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.97rem;
  }

  .draft {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
    background: #b45309;
    color: #fff;
  }

  @media (max-width: 520px) {
    .posts li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
