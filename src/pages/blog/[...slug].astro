---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="container narrow">
    <p class="back"><a href="/blog/">← Blog</a></p>
    <header class="page-head">
      <time class="eyebrow" datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
      </time>
      <h1>{post.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back {
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
  }

  .page-head h1 {
    margin-top: 0.35rem;
  }
</style>
