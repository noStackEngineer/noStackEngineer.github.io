---
import { existsSync } from 'node:fs';
import { site } from '../data/site';
import { getPosts } from '../lib/content';

// The Blog link appears once there is at least one published post, and the
// CV link once public/cv.pdf exists.
const hasPosts = (await getPosts()).length > 0;
const hasCv = existsSync('public/cv.pdf');

const nav = [
  { label: 'Projects', href: '/projects/' },
  { label: 'Experience', href: '/experience/' },
  { label: 'Publications', href: '/publications/' },
  ...(hasPosts ? [{ label: 'Blog', href: '/blog/' }] : []),
  ...(hasCv ? [{ label: 'CV', href: '/cv.pdf' }] : []),
];

const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/cv.pdf' && path.startsWith(href.replace(/\/$/, ''));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
              <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"></path>
              </g>
            </svg>
            <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z"></path>
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root = document.documentElement;
  const current = () =>
    root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  button?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    min-height: 4rem;
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
  }

  .brand {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--text);
    text-decoration: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.97rem;
    font-weight: 500;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text);
  }

  .moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }
</style>
