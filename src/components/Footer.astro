---
import { site, links } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p>© {year} {site.name}</p>
    <ul class="link-row">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--faint);
    font-size: 0.92rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }

  p {
    margin: 0;
  }

  .link-row {
    font-weight: 400;
  }
</style>
