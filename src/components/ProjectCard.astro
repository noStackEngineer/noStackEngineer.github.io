---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, kind, period, tags, image, imageAlt, draft } = project.data;
const href = `/projects/${project.id}/`;
---

<article class="card">
  <a class="media" href={href} tabindex="-1" aria-hidden="true">
    {
      image ? (
        <Image src={image} alt="" widths={[480, 800]} sizes="(max-width: 700px) 100vw, 30rem" />
      ) : (
        <div class="placeholder">
          <span>{title}</span>
        </div>
      )
    }
  </a>
  <div class="body">
    <p class="eyebrow">
      {kind} · {period}
      {draft && <span class="draft">Draft</span>}
    </p>
    <h3><a href={href}>{title}</a></h3>
    <p class="summary">{summary}</p>
    <ul class="tags">
      {tags.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }

  .media {
    display: block;
    text-decoration: none;
    aspect-ratio: 16 / 9;
    background: var(--accent-soft);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 1.5rem;
    text-align: center;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--accent);
    background:
      radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 55%),
      var(--accent-soft);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem 1.3rem;
    flex: 1;
  }

  .eyebrow {
    margin: 0;
  }

  .draft {
    margin-left: 0.5rem;
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
    background: #b45309;
    color: #fff;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .summary {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
    flex: 1;
  }

  .tags {
    margin-top: 0.35rem;
  }
</style>
